# Copy to .env (or .env.local) next to package.json. Read only by the server (server/api); nothing here
# is ever sent to the browser.

# Google AI (Gemini API) key: story writing, doodles, pictures, voices and music.
# Free keys work for everything except pictures (3D, flat, watercolour, charcoal, photo, anime),
# which need billing turned on in Google AI Studio.
GEMINI_API_KEY=

# Signs the browser session cookie and generated file names. Any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Optional: Google Cloud Text-to-Speech, only if a language Gemini TTS can't speak is added
# (English, Urdu, Hindi and Arabic all use Gemini TTS; see server/api/lang-support.json).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Optional model overrides (defaults checked against ai.google.dev on 2026-10-21):
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# GEMINI_STORY_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GOOGLE_MUSIC_MODEL=models/lyria-realtime-exp
# PORT=8787
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
